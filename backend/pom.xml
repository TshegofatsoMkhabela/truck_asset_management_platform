<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
        <relativePath/>
    </parent>

    <groupId>za.co.ice.tamp</groupId>
    <artifactId>backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>TAMP Backend</name>
    <description>Orchestrator service: public API, auth, persistence, and calls to matching-service</description>

    <properties>
        <java.version>21</java.version>
        <!-- Overrides Spring Boot 3.5.5's managed 1.21.3. Docker Engine 29 refuses API
             versions below 1.44, which the older Testcontainers/docker-java client requests. -->
        <testcontainers.version>2.0.5</testcontainers.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- RBAC, password hashing (BCryptPasswordEncoder) and the stateless JWT filter chain
             for #9. A vetted library rather than hand-rolled auth, per the issue's own reasoning. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- jjwt: issues and verifies the signed JWT (JSON Web Token) returned on login. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Feature code reads and writes through entities and repositories, never SQL
             strings. The schema itself stays owned by db/migrations (#6); ddl-auto is set
             to validate, not update or create, so Hibernate checks the mapping against that
             schema rather than generating one of its own. See ADR-3. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Default (compile) scope, not test-only: the running application needs this driver
             to reach PostgreSQL, InetAddressConverter references org.postgresql.util.PGobject
             directly from main code, and the schema tests reuse the same dependency rather than
             a second copy. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Brief section 7 lists an OpenAPI file as a required submission artifact, and
             section 2.2 names Swagger/OpenAPI as the back-end demonstration vehicle; every
             feature issue from #10 onward also carries its own OpenAPI acceptance criterion.
             #10, #13 and #9 each independently added this dependency for that reason,
             discovered as a merge conflict rather than planned; kept here as one copy,
             covering #9's JWT bearer security scheme alongside #10's and #13's needs.
             Auto-exposes /swagger-ui.html and /v3/api-docs with zero configuration beyond
             this dependency. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.9</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
                Tests tagged "e2e" need a live matching-service on the network, so
                they are excluded from the default run. Without this, the per-service
                `backend (Java)` CI job from #2 would depend on a running Python
                process — destroying the per-service independence that is that
                issue's whole point, and turning every backend failure into "which
                service actually broke?".

                Run them with `mvn verify -Pe2e` (see the e2e profile below).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>e2e</excludedGroups>
                </configuration>
            </plugin>

            <!--
                Line coverage is measured and gated at 80%. The gate is bound to
                `verify` so it fails the build rather than merely reporting.

                BackendApplication is excluded: its only statement is the
                SpringApplication.run bootstrap, which tests never invoke (the
                Spring test context loads the class directly). Covering it would
                mean writing a test that calls main() purely to move the number —
                coverage theatre of exactly the kind this gate exists to prevent.
                The exclusion is one named class, not a package glob, so any real
                logic added elsewhere is still measured.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <configuration>
                    <excludes>
                        <exclude>za/co/ice/tamp/backend/BackendApplication.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            `mvn verify -Pe2e` runs ONLY the e2e-tagged tests, against a
            matching-service that must already be running (see the CI e2e job and
            the README). Coverage checking is skipped here: this run executes a
            single round-trip test and would report a meaningless percentage, and
            failing the build on it would make the e2e job red for a reason that has
            nothing to do with integration. The real coverage gate stays on the
            default build, where it measures the full unit suite.
        -->
        <profile>
            <id>e2e</id>
            <properties>
                <jacoco.skip>true</jacoco.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>e2e</groups>
                            <excludedGroups combine.self="override"/>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
