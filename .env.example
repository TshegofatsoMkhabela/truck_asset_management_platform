# Copy this file to .env before running `docker compose up`. .env is gitignored;
# .env.example is the only one ever committed, and holds no real value for any of
# these, only placeholders (#8, brief section 4 "controlled configuration").
#
# Names match docker-compose.yml's `db` service (#7) and application.yml's own
# defaults exactly: DB_NAME/DB_USERNAME/DB_PASSWORD, not POSTGRES_*.

DB_NAME=tamp
DB_USERNAME=tamp
DB_PASSWORD=change-me-locally
DB_PORT=5432

# Signs and verifies the JWTs issued at login (#9). Any long random string works for
# local/demo use; generate one with `openssl rand -base64 32` rather than typing one.
JWT_SECRET=change-me-to-a-random-32-byte-string
